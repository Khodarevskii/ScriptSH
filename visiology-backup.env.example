# Настройки visiology-backup.sh
#
# Положить как /etc/visiology-backup.env и закрыть права: chmod 600
# (здесь могут быть пароли).
#
# Все различия между серверами живут здесь. Сам скрипт побайтно одинаков на
# всех машинах и обновляется простым копированием, не затирая настройки.
#
# Формат KEY=VALUE, строки с # игнорируются. Кавычки не обязательны.
# Ключи, которых здесь нет, скрипт игнорирует.

########################################
# ОБЯЗАТЕЛЬНО
########################################
# Без этих четырёх значений прогон прерывается сразу: ошибка в них означает
# снапшот не того тома или копию данных не на том диске.

# Группа томов и логический том, с которого снимается снапшот. Смотреть: sudo lvs
VG_NAME=ubuntu-vg
LV_NAME=ubuntu-lv

# Диск, с которого берётся место под COW снапшота. Должен входить в VG_NAME.
# Смотреть: sudo pvs. На разных серверах имя разное - проверяйте, не копируйте.
SNAP_PV=/dev/sdg

# Куда кладётся копия данных ClickHouse на время выгрузки. Нужен объём порядка
# размера базы. Каталог создаётся сам и удаляется после прогона.
CH_COPY_DIR=/mnt/disk2/vis_ch_copy

########################################
# ОТЧЁТ ПО ПОЧТЕ
########################################
# Пустой MAIL_TO отключает отправку целиком.
MAIL_TO=admin@example.ru
MAIL_FROM=visiology-backup@example.ru

SMTP_HOST=mail.example.ru
SMTP_PORT=25

# Шифрование. Режим должен соответствовать порту, иначе соединение висит до
# таймаута: порт 25 и 587 - обычно STARTTLS, порт 465 - SSL с первого байта.
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Не проверять сертификат релея. Для внутреннего самоподписанного.
SMTP_SKIP_VERIFY=true

# Оставить пустыми, если релей принимает без авторизации.
SMTP_USER=
SMTP_PASSWORD=

########################################
# УДАЛЁННОЕ ХРАНИЛИЩЕ АРХИВОВ
########################################
# Работает только с ключом --remote-store в строке запуска. Пустой REMOTE_HOST
# доставку отключает.
#
# Доступ по ключу. Ключ хоста должен быть заранее в /root/.ssh/known_hosts:
# соединение идёт в пакетном режиме и на запрос подтверждения не ответит.
#   sudo sh -c 'ssh-keyscan -p 22 АДРЕС >> /root/.ssh/known_hosts'

# Имя или IP-адрес, равнозначно.
REMOTE_HOST=
REMOTE_USER=visiology-backup
REMOTE_PORT=22
REMOTE_KEY=/root/.ssh/id_visiology_backup

# Корень на хранилище. Архивы лягут в <корень>/<папка сервера>/
REMOTE_ROOT=/mnt/disk2/visiology-backup

# Имя папки этого сервера внутри корня. Пусто - берётся имя хоста
# (например srv-stand). Задайте своё, если имена хостов неудобны или
# сервер переименовывали. Косая черта в имени запрещена.
REMOTE_DIR_NAME=

# Права на доставленный архив. Выставляются явно после передачи: scp сохраняет
# режим исходного файла, а он зависит от umask боевого сервера - при строгом
# umask архив пришёл бы с правами 600 и группа сопровождения его не прочитала бы.
# 640 - владелец пишет, группа читает. Пусто - права не трогать.
REMOTE_FILE_MODE=640

# Права на папку сервера внутри корня. Тоже выставляются явно, иначе зависели бы
# от umask хранилища. 755 позволяет любому сотруднику зайти и увидеть список
# архивов, а прочитать их сможет только владелец, то есть через sudo.
# Корень (REMOTE_ROOT) скрипт не трогает - его права выставляет администратор.
REMOTE_DIR_MODE=755

# Способ передачи: scp | rsync | auto.
# scp есть везде; rsync докачивает прерванное и проверяет переданное сам.
REMOTE_METHOD=scp

# Вход по паролю вместо ключа. Требует sshpass. Ключ надёжнее: его можно
# ограничить на стороне хранилища и отозвать отдельно для каждого сервера.
# Пароль передаётся процессу через окружение, в аргументах команд не появляется.
# REMOTE_PASSWORD=
# REMOTE_PASSWORD_FILE=/etc/visiology-backup.pass

# Срок хранения истории в папке этого сервера, дней.
REMOTE_RETENTION_DAYS=30
# Сколько свежих архивов остаются независимо от возраста. Страховка на случай,
# когда бэкапы не снимались дольше срока хранения.
REMOTE_KEEP_MIN=2
# Ограничение по времени на передачу одного архива.
REMOTE_XFER_TIMEOUT=4h
# Сверка контрольной суммы после передачи: auto | always | never.
# При auto считается только для scp - rsync проверяет целостность сам.
REMOTE_VERIFY_CHECKSUM=auto

########################################
# КОПИЯ НА ТЕСТОВЫЙ СТЕНД
########################################
# Работает только с ключом --test-store. Ставится на одном сервере - том,
# чьими данными наполняется тест. Пустой TEST_HOST копию отключает.
#
# Локальные архивы от этого назначения не зависят: недоступность теста даёт
# замечание в письме и ничего больше. Судьба локальных копий определяется
# только основным хранилищем.
#
# Всё, кроме адреса и каталога, наследуется от REMOTE_*: обычно отличаются
# только они. Раскомментируйте нужное, если на тесте другой пользователь,
# порт или ключ.
TEST_HOST=
TEST_ROOT=/mnt/disk2/from-prod

# Имя папки на тесте. Пусто - берётся REMOTE_DIR_NAME, а если и он пуст,
# то имя хоста.
# TEST_DIR_NAME=
# TEST_FILE_MODE=640
# TEST_DIR_MODE=755

# TEST_USER=visiology-backup
# TEST_PORT=22
# TEST_KEY=/root/.ssh/id_visiology_backup
# TEST_METHOD=scp
# TEST_PASSWORD=
# TEST_PASSWORD_FILE=

# На тесте история не нужна: там держится последняя копия, место дороже.
# TEST_RETENTION_DAYS=7
# TEST_KEEP_MIN=1
# TEST_XFER_TIMEOUT=4h
# TEST_VERIFY_CHECKSUM=auto

########################################
# ПРОЧЕЕ (обычно менять не нужно)
########################################
# Значения ниже одинаковы на всех контурах. Раскомментируйте только то, что
# действительно отличается на этом сервере.

# Имя и точка монтирования снапшота.
# SNAP_NAME=visiology_backup_snap
# SNAP_MNT=/mnt/vis_snap

# Минимум свободного места под COW снапшота, МБ.
# SNAP_MIN_MB=1024

# Нижние пороги свободного места, ГБ: защита от полного диска, а не расчёт под
# объём данных. Поднимайте под реальный размер бэкапа.
# BACKUP_MIN_GB=20
# CH_COPY_MIN_GB=20

# Образ временного сервера ClickHouse и выгружаемая база.
# CH_IMAGE=cr.yandex/crpe1mi33uplrq7coc9d/visiology/release/original/clickhouse-server:24.8.11.51285-alpine
# CH_DB=visiology
# CH_TEMP_NAME=ch_temp_backup

# Резервные значения, если ни backup-service, ни Swarm опросить не удалось.
# CH_HOST_LABEL=clickhouse-1
# CH_VOLUME=visiology3_clickhouse_data

# Ресурсы временного сервера ClickHouse и число параллельных выгрузок.
# CH_CPUS=4
# CH_MEMORY=16g
# CH_CPU_SHARES=512
# DUMP_PARALLEL=4
