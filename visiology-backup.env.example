# Необязательный файл настроек отчёта visiology-backup.sh.
#
# Все эти параметры уже есть в самом скрипте, в блоке "ОТЧЁТ ПО ПОЧТЕ". Файл
# нужен только если пароль не хотят держать в скрипте: заданные здесь значения
# перекрывают заданные там.
#
# Положить как /etc/visiology-backup.env и закрыть права: chmod 600.
# Формат KEY=VALUE, строки с # игнорируются. Кавычки не обязательны.

# Почтовый релей контура.
SMTP_HOST=mail.example.ru
SMTP_PORT=25

# Шифрование. Режим должен соответствовать порту, иначе соединение висит до
# таймаута: порт 25 и 587 - обычно STARTTLS, порт 465 - SSL с первого байта.
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Не проверять сертификат релея. Только для внутреннего самоподписанного.
SMTP_SKIP_VERIFY=false

# Учётные данные. Оставить пустыми, если релей принимает без авторизации.
SMTP_USER=
SMTP_PASSWORD=

# Отправитель и получатели. MAIL_TO - через запятую.
# Пустой MAIL_TO отключает отправку.
MAIL_FROM=visiology-backup@example.ru
MAIL_TO=admin@example.ru

# --- Удалённое хранилище архивов (работает с ключом --remote-store) ---
# Адрес: имя или IP-адрес, равнозначно.
REMOTE_HOST=10.0.0.10
REMOTE_USER=backup
REMOTE_PORT=22

# Способ передачи: scp | rsync | auto
REMOTE_METHOD=scp

# Вход по ключу - предпочтительный вариант.
REMOTE_KEY=/root/.ssh/id_visiology_backup

# Вход по паролю вместо ключа. Требует sshpass. Пароль хранить только здесь,
# при правах 600 на этот файл, и никогда в самом скрипте. Передаётся процессу
# через окружение, в аргументах команд не появляется.
# REMOTE_PASSWORD=
# Либо путь к файлу, где лежит только пароль:
# REMOTE_PASSWORD_FILE=/etc/visiology-backup.pass
REMOTE_ROOT=/srv/visiology-backups
REMOTE_RETENTION_DAYS=30
REMOTE_KEEP_MIN=2
REMOTE_XFER_TIMEOUT=4h
# auto | always | never
REMOTE_VERIFY_CHECKSUM=auto
